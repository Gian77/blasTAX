#!/bin/bash -login

#SBATCH --time=12:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBACTH -A shade-cole-bonito
#SBATCH --job-name blasTAX
#SBATCH --output=slurm-%A_blasTAX.out

cd ${SLURM_SUBMIT_DIR}

bash blasTAX.sh -i sequences/bryan.fasta -d /mnt/research/EvansLab/DATABASES/NCBInt_feb23 -t 16 --max_hits 25 -c 0.60 -e 0.001 -p 90.0 -o /mnt/home/benucci/blasTAX/outputs

echo -e "\n========= Sbatch log =========\n"
echo -e "\n Current directory: `pwd` \n"
echo -e "\n `sacct -u benucci -j $SLURM_JOB_ID --format=JobID,JobName,Start,End,Elapsed,NCPUS,ReqMem` \n"
scontrol show job $SLURM_JOB_ID
